PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/carevault
MONGODB_DATABASE=carevault
CORS_ORIGINS=http://localhost:5173
# Production demo patient/doctor provisioning is disabled unless explicitly enabled.
# Enable only after reviewing the seeding impact and approving the demo data uploads.
ENABLE_DEMO_ACCOUNTS=false
# In production, set CORS_ORIGINS to the exact deployed frontend origin(s), comma-separated.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_FROM=CareVault <your-gmail-address@gmail.com>
# Optional document analysis. Uploads continue if Groq is unavailable or unset.
GROQ_API_KEY=
# Required to process queued jobs. Choose a current strict JSON Schema model:
# openai/gpt-oss-20b, openai/gpt-oss-120b, or qwen/qwen3.8-27b
GROQ_MODEL=
# Digital PDFs may contain up to this many pages; OCR is limited separately.
DOCUMENT_MAX_PDF_PAGES=20
# Scanned PDFs above this size fail with a split-the-file message instead of slow OCR.
DOCUMENT_OCR_MAX_PAGES=8
